# Copy to .env and fill in. .env is git-ignored — never commit real values.
# Loaded once by edu_pipeline/__init__.py; real environment variables win.

# ---------------------------------------------------------------------------
# MySQL (question bank + chapter/theory tables)
# ---------------------------------------------------------------------------
# Preferred: connect over a UNIX socket (leave DB_HOST/DB_PORT unused).
DB_SOCKET=/tmp/mysql.sock
DB_USER=root
DB_PASSWORD=
DB_NAME=foundation

# TCP fallback — used only when DB_SOCKET is empty.
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------------------
# Mathpix (PDF OCR). Required only to extract a NEW PDF; already-extracted
# books in edu_pipeline/workspace/ work without it.
# ---------------------------------------------------------------------------
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ---------------------------------------------------------------------------
# Ollama (local LLM). Required for notes + MCQ generation.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=1800
# Notes generation uses a larger model with a fallback:
NOTES_MODEL=qwen3:14b
NOTES_FALLBACK_MODEL=qwen3:12b

# ---------------------------------------------------------------------------
# Servers
# ---------------------------------------------------------------------------
APP_PORT=8000
VIEWER_API_PORT=8765

# HMAC key for assessment bearer tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is persisted to edu_pipeline/assessment/.secret
ASSESS_SECRET=
