# Copy to .env and fill in. `make setup` does the copy for you.
# Nothing here may carry a real value -- .env is the file that holds secrets,
# and it is not version-controlled.

# Mathpix OCR (edu_pipeline/materials/cache/ keeps results, so re-runs are free)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# MySQL. DB_SOCKET is preferred when present; DB_HOST/DB_PORT are the fallback.
DB_SOCKET=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foundation

# Ollama (local LLM used for key points, summaries and MCQ generation)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=300

# Signing key for assessment bearer tokens. Generate one per deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
ASSESS_SECRET=

# Extraction switches. SKIP_LLM=1 extracts without Ollama running.
SKIP_LLM=
SKIP_IMAGES=
IMAGE_MAX_DIM=1000
IMAGE_JPEG_QUALITY=78
