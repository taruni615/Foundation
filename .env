# MySQL connection for the IIT Foundation question bank.
# The backend (app_server.py) loads this file on startup.
# Your MySQL connects via a UNIX socket as root, so DB_SOCKET is set.
# >>> Put your MySQL root password in DB_PASSWORD, then restart the server. <<<
DB_SOCKET=/tmp/mysql.sock
DB_USER=root
DB_PASSWORD=Taruni@2005
DB_NAME=foundation
# (TCP fallback — used only if DB_SOCKET is empty)
DB_HOST=127.0.0.1
DB_PORT=3306
